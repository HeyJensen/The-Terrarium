# Copy to config/.env (git-ignored) or export these in your shell.
# NEVER commit real values. Nothing in this repo prints or logs them.

# --- Robinhood (Agentic Trading) ---------------------------------------
# Robinhood's agentic access is an MCP server with browser OAuth; there is
# no API key to paste here. The OAuth token cache path is the only setting.
# See docs/robinhood-oauth-setup.md.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_OAUTH_TOKEN_FILE=

# --- Live-order arming ---------------------------------------------------
# Live orders need BOTH settings.json trader.order_routing = "live"
# AND this exact value. Anything else keeps the engine in dry run.
TRADER_LIVE_ARMED=

# --- Dashboard -----------------------------------------------------------
DASHBOARD_URL=http://127.0.0.1:8787
# Shared secret agents send when POSTing status. Generate any long random string.
DASHBOARD_TOKEN=

# --- Telegram (Phase 2, off until approved) ------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Buffer (social posting; free plan includes the API) -----------------
# Buffer > Settings > API. Used only by agents/social to queue approved posts.
BUFFER_API_KEY=
